# ==== YYC3-MiniMax-H3 工作台（apps/console）环境变量示例 ====
# 复制为真实配置后填写；真值一律存放 .secrets/（600 权限，gitignore 隔离），禁止入库/入文档。
# 详细说明见 docs/17-工作台部署环境清单.md

# ---- 0379-World 网关（任务中心必需）----
# 网关地址：Tailscale 优先（跨网络可达）；LAN IP 仅同网段可用
H3_GATEWAY_URL=http://100.65.172.88:8000
# 业务键：取自 .secrets/api_keys_live_20260926.env → API_KEY_LIVE_20260926（X-API-Key）
H3_GATEWAY_API_KEY=

# ---- AI 助手（LLM，可选——缺省复用 H3_GATEWAY_API_KEY）----
# OpenAI 兼容端点：${H3_GATEWAY_URL}/v1（2026-10-05 实测：/v1/models + /v1/chat/completions 流式达标）
H3_LLM_BASE_URL=
H3_LLM_API_KEY=
# 实测可用模型：glm-4-flash（默认，128k）/ glm-4-plus / deepseek-chat / deepseek-v4-flash 等 16 个
H3_LLM_MODEL=glm-4-flash

# ---- 令牌鉴权（推荐配置；未配置时仅回环放行）----
# /api/tasks/**：X-Claim-Token 常量时间比较
TASKS_CLAIM_TOKEN=
# /api/pipeline 与 /api/score：Authorization: Bearer
PIPELINE_TOKEN=
# 远程访问（私网外）签发会话令牌的预共享密钥：X-Session-Key 头
H3_SESSION_KEY=

# ---- 运行参数（可选）----
# 流水线 Python 解释器（默认 python3）
PIPELINE_PYTHON=
# 生产端口（默认 3030）；dev API 内端口 3031 见 scripts/dev.mjs 与 vite.config.ts
CONSOLE_PORT=3030
# agent 网关基址（分镜确认闸门代理；需先启动 uvicorn agent.h3_agent.gateway:app --port 8300）
H3_AGENT_URL=http://127.0.0.1:8300
