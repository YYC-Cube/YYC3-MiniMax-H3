# 依赖与构建产物
node_modules/
.next/
out/
dist/
dist-landing/
*.tsbuildinfo
next-env.d.ts

# 环境变量
.env
.env.*
!.env.example

# 本机密钥保管（P0-S1：真实密钥只存此处，600 权限）
.secrets/
agent/data/

# ==== 引擎区（Python 产物与权重，禁入库）====
models/
checkpoints/
ref_images/
# 锚定根目录：裸 data/ 会命中任意层级 data 目录（含 dashboard/data），
# 使下方 !batches.json 否定失效——根 data/ 才是引擎数据目录
/data/
output_batch*/
output_logs/

# 运行时产物（夜间批量报告/nas 归档日志）
logs/
report_batch*.md
analysis_result_batch*.md
logs_*.log
# 仅排除 dashboard/data/ 的内容而非目录本身：否则父目录排除会在路径遍历层剪枝，
# 使下方 !batches.json 否定无法重新包含（git add 报 "paths are ignored"）
dashboard/data/*
# Pages 快照数据（GitHub Pages 部署随仓库分发；仅生产指标无敏感信息）
!dashboard/data/batches.json
*.safetensors
*.pth
*.ckpt

# 缓存
__pycache__/
*.pyc
.DS_Store

# 嵌套 git 参考克隆（上游 fp8 缓解进展跟进）
docs/dgxspark_comfyui_minimax_h3/
# 推理引擎克隆（docs/01 §4 获取；P2-1 首尾帧探测读取其 minimax_h3 管线）
vendor/DiffSynth-Studio/
.venv/

# agent 运行时状态（编排器快照 / NAS 待归档队列）
projects/
.nas_pending

# ==== Agent Skills（npx skills CLI 管理）====
# 唯一 canonical 入库：.agents/skills/（跨代理标准位）+ skills-lock.json
# 其余代理目录为 CLI 本地副本，重装同步：npx skills add https://modelscope.cn/collections/MiniMax/MiniMax-H3-Skills --skill h3-prompt-writing --copy -y
.aider-desk/
.claude/
.codebuddy/
.continue/
.crush/
.goose/
.hermes/
.qoder/
.reasonix/
.trae/
.zcode/
# 根锚定：避免误伤 canonical 的 .agents/skills/
/skills/

# update_seed_list 写回备份
*.bak
