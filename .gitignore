# ============================================================

# ---- macOS ----
.DS_Store
._*
.AppleDouble
.LSOverride

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.conda/
*.egg

# ---- 模型权重（72.5GB 级，严禁入库）----
models/
*.pth
*.model
*.safetensors

# ---- 批次产物 / 运行数据（manifest 可重建）----
output_batch*/
*.log
report_batch*.md
analysis_result*.md

# ---- 数据集 / 参考素材 ----
data/
ref_images/

# ---- 第三方引擎（如需锁定版本可注释掉下行并入库）----
# vendor/

# ---- IDE / 编辑器 ----
.vscode/
.idea/

# ---- 环境变量 ----
.env
.env.*
!.env.example
